# Configuration of the attractor project. setup_env.sh copies this file to .env
# (ignored by git) and exports every variable; the scripts also read .env directly.

# Directory holding C1.csv ... C10.csv
DATA_PATH=data
# Directory receiving periods.csv and periods.png
RESULTS_PATH=results
# Number of threads used by the BLAS library behind NumPy
OMP_NUM_THREADS=4
# Matplotlib backend; Agg writes image files without opening a window
MPLBACKEND=Agg
# OpenAI-compatible chat endpoint for ask_llm.py; the course endpoint URL is given in the lecture
LLM_BASE_URL=http://localhost:8080/v1
# Key sent to the endpoint; a local llama-server accepts any string
LLM_API_KEY=EMPTY
# Model name requested from the endpoint
LLM_MODEL=qwen3.8-flash-next
